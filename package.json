{
  "name": "alchni",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @alchni/app dev",
    "web": "pnpm --filter @alchni/app web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "2.11.7"
  }
}
